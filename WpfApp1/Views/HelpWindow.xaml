<Window x:Class="WpfPresentation.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="560" Height="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Fade-in окна -->
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <!-- Slide-up контента -->
                    <DoubleAnimation Storyboard.TargetName="ContentSlide"
                                     Storyboard.TargetProperty="Y"
                                     From="18" To="0"
                                     Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FAC775"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D3D1C7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#888780"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>

        <Style x:Key="UnitName" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#D3D1C7"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <Style x:Key="AbilityText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#6B9AD1"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder"
            Background="#2C2C2A"
            BorderBrush="#5F5E5A"
            BorderThickness="1"
            Opacity="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0"
                    Background="#252523"
                    BorderBrush="#444441"
                    BorderThickness="0,0,0,1"
                    Padding="20,11"
                    MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="✦" Foreground="#EF9F27" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="КАК ИГРАТЬ"
                                   FontFamily="Georgia" FontSize="12"
                                   Foreground="#888780"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="✦" Foreground="#EF9F27" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            FontSize="12"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#5F5E5A"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#33FF6B6B"/>
                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Контент со slide-up -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.RenderTransform>
                    <TranslateTransform x:Name="ContentSlide" Y="0"/>
                </ScrollViewer.RenderTransform>

                <StackPanel Margin="24,20,24,28">

                    <!-- ── Заголовок ──────────────────────────────────────── -->
                    <TextBlock Text="Битва армий"
                               FontFamily="Georgia" FontSize="26"
                               Foreground="#FAC775"
                               HorizontalAlignment="Center"/>
                    <Rectangle Height="1" Fill="#EF9F27" Width="60"
                               HorizontalAlignment="Center" Margin="0,8,0,6"/>
                    <TextBlock Text="Пошаговая стратегия в средневековом сеттинге. Соберите армию и разгромите противника."
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- ── Цель ───────────────────────────────────────────── -->
                    <TextBlock Text="ЦЕЛЬ ИГРЫ" Style="{StaticResource SectionHeader}"/>
                    <Rectangle Height="1" Fill="#3A3A38" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,24">
                        Две армии сражаются поочерёдно. Каждый ход атакует одна сторона: фронтовые юниты бьются в рукопашную, а тыловые используют спецспособности. Победа достаётся армии, у которой остались живые юниты.
                    </TextBlock>

                    <!-- ── Юниты ──────────────────────────────────────────── -->
                    <TextBlock Text="ЮНИТЫ" Style="{StaticResource SectionHeader}"/>
                    <Rectangle Height="1" Fill="#3A3A38" Margin="0,0,0,12"/>

                    <!-- Тяжёлый -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⚔" FontSize="16" Foreground="#EF9F27"
                                   VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Тяжёлый воин" Style="{StaticResource UnitName}"/>
                            <TextBlock Style="{StaticResource MutedText}">Высокие ATK и DEF. Нет спецспособностей, но может получать баффы от оруженосца. Основа любой армии.</TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Лёгкий -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🏃" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Лёгкий воин" Style="{StaticResource UnitName}"/>
                            <TextBlock Style="{StaticResource MutedText}">Быстрый юнит с низким базовым уроном.</TextBlock>
                            <TextBlock Style="{StaticResource AbilityText}">✦ Оруженосец — с шансом 70% надевает случайный бафф (конь, копьё, щит или шлем) на соседнего тяжёлого союзника.</TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Лучник -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🏹" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Лучник" Style="{StaticResource UnitName}"/>
                            <TextBlock Style="{StaticResource MutedText}">Слабее в рукопашном бою, но опасен из тыла.</TextBlock>
                            <TextBlock Style="{StaticResource AbilityText}">✦ Выстрел — атакует любого врага в пределах дальности. Работает из тыла, не требует выхода на фронт.</TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Целитель -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="✚" FontSize="15" Foreground="#6BAD5E"
                                   VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Целитель" Style="{StaticResource UnitName}"/>
                            <TextBlock Style="{StaticResource MutedText}">Почти не воюет в рукопашную — ценность в тылу.</TextBlock>
                            <TextBlock Style="{StaticResource AbilityText}">✦ Лечение — восстанавливает HP союзнику в радиусе. Не лечит тяжёлых воинов и самого себя. Клонируется магом.</TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Маг -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔮" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Маг" Style="{StaticResource UnitName}"/>
                            <TextBlock Style="{StaticResource MutedText}">Хрупкий, но способен изменить ход боя.</TextBlock>
                            <TextBlock Style="{StaticResource AbilityText}">✦ Клонирование — с базовым шансом создаёт копию лёгкого воина или лучника. Каждая неудача повышает шанс на 5%, успех сбрасывает счётчик. Дальность тоже важна — промах из дальней дистанции также копит шанс.</TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- Гуляй-город -->
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🛡" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Гуляй-город" Style="{StaticResource UnitName}"/>
                            <TextBlock Style="{StaticResource MutedText}">Подвижное деревянное укрепление. Не атакует, не лечится, не клонируется. Служит живым щитом — высокая защита поглощает урон вместо союзников за ним.</TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- ── Баффы ───────────────────────────────────────────── -->
                    <TextBlock Text="БАФФЫ" Style="{StaticResource SectionHeader}"/>
                    <Rectangle Height="1" Fill="#3A3A38" Margin="0,0,0,12"/>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10">
                        Лёгкий воин-оруженосец может экипировать соседнего тяжёлого одним из четырёх уникальных баффов. Каждый тип — не более одного раза на юнита.
                    </TextBlock>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🐴  Конь" Style="{StaticResource BodyText}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="+2 ATK, +2 DEF" Style="{StaticResource MutedText}"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🗡  Копьё" Style="{StaticResource BodyText}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="+3 ATK" Style="{StaticResource MutedText}"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🛡  Щит" Style="{StaticResource BodyText}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="+3 DEF" Style="{StaticResource MutedText}"/>
                    </Grid>
                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⛑  Шлем" Style="{StaticResource BodyText}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="+2 DEF" Style="{StaticResource MutedText}"/>
                    </Grid>

                    <!-- ── Построения ─────────────────────────────────────── -->
                    <TextBlock Text="ПОСТРОЕНИЯ" Style="{StaticResource SectionHeader}"/>
                    <Rectangle Height="1" Fill="#3A3A38" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="▬" FontSize="12" Foreground="#EF9F27"
                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Бой на мосту" Style="{StaticResource UnitName}"/>
                            <TextBlock Style="{StaticResource MutedText}">Одна колонна. Только первый юнит бьётся в рукопашную. Остальные используют способности из тыла. Узкий строй — проще держать фронт, но способности работают одновременно у всех тыловых.</TextBlock>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="▦" FontSize="12" Foreground="#EF9F27"
                                   VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Широкий мост" Style="{StaticResource UnitName}"/>
                            <TextBlock Style="{StaticResource MutedText}">3 ряда по ширине. Фронтовые юниты бьются попарно по рядам, тыловые — используют способности. Позволяет одновременно задействовать несколько бойцов в рукопашной.</TextBlock>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="≡" FontSize="16" Foreground="#EF9F27"
                                   VerticalAlignment="Top" Margin="0,0,0,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Стенка на стенку" Style="{StaticResource UnitName}"/>
                            <TextBlock Style="{StaticResource MutedText}">Все юниты выстроены в одну линию и считаются фронтовыми. Все бьются попарно по строкам — спецспособности доступны только тем, напротив кого нет врага. Самое кровопролитное построение.</TextBlock>
                        </StackPanel>
                    </Grid>

                    <!-- ── Управление ─────────────────────────────────────── -->
                    <TextBlock Text="УПРАВЛЕНИЕ В БОЮ" Style="{StaticResource SectionHeader}"/>
                    <Rectangle Height="1" Fill="#3A3A38" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Сделать ход" Style="{StaticResource BodyText}" FontSize="12" Foreground="#FAC775"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MutedText}">Выполнить один раунд боя.</TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Undo / Redo" Style="{StaticResource BodyText}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MutedText}">Отменить или повторить последний ход.</TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Сброс" Style="{StaticResource BodyText}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MutedText}">Вернуть бой к исходному состоянию.</TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Авторежим" Style="{StaticResource BodyText}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MutedText}">Бой ведётся автоматически до победителя.</TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Изменить построение" Style="{StaticResource BodyText}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MutedText}">Сменить тактику прямо во время боя.</TextBlock>
                    </Grid>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Сохранить" Style="{StaticResource BodyText}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource MutedText}">Сохранить текущий бой для продолжения позже. Загрузка — через «Загрузить игру» в главном меню.</TextBlock>
                    </Grid>

                    <!-- Декор -->
                    <TextBlock Text="✦ ✦ ✦"
                               Foreground="#3A3A38"
                               FontSize="12"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
