<UserControl x:Class="WpfPresentation.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#22D3D1C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#44D3D1C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#2C2C2A">
        <StackPanel Width="360"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Заголовок -->
            <TextBlock Text="Казна"
                       FontFamily="Georgia"
                       FontSize="28"
                       Foreground="#FAC775"
                       HorizontalAlignment="Center"/>

            <Rectangle Height="1" Fill="#EF9F27" Width="80"
                       HorizontalAlignment="Center" Margin="0,12,0,12"/>

            <TextBlock Text="Укажите бюджет для каждой из армий"
                       FontFamily="Georgia"
                       FontSize="13"
                       Foreground="#888780"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,32"/>

            <!-- Поле ввода -->
            <TextBlock Text="БЮДЖЕТ (МОНЕТЫ)"
                       FontSize="11"
                       Foreground="#888780"
                       Margin="0,0,0,8"/>

            <Border BorderBrush="#888780"
                    BorderThickness="1"
                    Background="#1A1A18"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="◆ "
                               Foreground="#EF9F27"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             x:Name="BudgetInput"
                             Text="300"
                             Foreground="#FAC775"
                             FontFamily="Georgia"
                             FontSize="18"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="#FAC775"
                             SelectionBrush="#44FAC775"
                             VerticalAlignment="Center"
                             PreviewTextInput="BudgetInput_PreviewTextInput"/>
                </Grid>
            </Border>

            <!-- Ошибка -->
            <TextBlock x:Name="ErrorText"
                       Text=""
                       Foreground="#E24B4A"
                       FontSize="12"
                       Margin="0,8,0,0"
                       Visibility="Collapsed"/>

            <!-- Кнопки -->
            <Grid Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Назад"
                        Foreground="#888780"
                        BorderBrush="#444441"
                        Style="{StaticResource NavButtonStyle}"
                        x:Name="BackButton"/>

                <Button Grid.Column="2"
                        Content="Далее →"
                        Foreground="#FAC775"
                        BorderBrush="#888780"
                        Style="{StaticResource NavButtonStyle}"
                        x:Name="NextButton"/>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>