<UserControl x:Class="WpfPresentation.Views.ArmySetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="Transparent"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#22D3D1C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#44D3D1C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButtonStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="UnitRowStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#5F5E5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#2C2C2A">
        <StackPanel Width="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Заголовок -->
            <TextBlock x:Name="TitleText"
                       Text="Армия 1"
                       FontFamily="Georgia"
                       FontSize="28"
                       Foreground="#FAC775"
                       HorizontalAlignment="Center"/>

            <Rectangle Height="1" Fill="#EF9F27" Width="80"
                       HorizontalAlignment="Center" Margin="0,12,0,8"/>

            <!-- Бюджет -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="Бюджет: "
                           FontFamily="Georgia" FontSize="13" Foreground="#888780"/>
                <TextBlock x:Name="BudgetText"
                           Text="300"
                           FontFamily="Georgia" FontSize="13" Foreground="#FAC775"/>
                <TextBlock Text=" монет  |  Осталось: "
                           FontFamily="Georgia" FontSize="13" Foreground="#888780"/>
                <TextBlock x:Name="RemainingText"
                           Text="300"
                           FontFamily="Georgia" FontSize="13" Foreground="#FAC775"/>
                <TextBlock Text=" монет"
                           FontFamily="Georgia" FontSize="13" Foreground="#888780"/>
            </StackPanel>

            <!-- Выбор режима -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="AutoBorder"
                        Grid.Column="0"
                        BorderBrush="#888780"
                        BorderThickness="1"
                        Background="#1AFAC775"
                        Padding="0,10"
                        Cursor="Hand"
                        MouseLeftButtonDown="AutoMode_Click">
                    <TextBlock Text="Автоматически"
                               FontFamily="Georgia" FontSize="13"
                               Foreground="#FAC775"
                               HorizontalAlignment="Center"
                               x:Name="AutoText"/>
                </Border>

                <Border x:Name="ManualBorder"
                        Grid.Column="2"
                        BorderBrush="#5F5E5A"
                        BorderThickness="1"
                        Background="Transparent"
                        Padding="0,10"
                        Cursor="Hand"
                        MouseLeftButtonDown="ManualMode_Click">
                    <TextBlock Text="Вручную"
                               FontFamily="Georgia" FontSize="13"
                               Foreground="#888780"
                               HorizontalAlignment="Center"
                               x:Name="ManualText"/>
                </Border>
            </Grid>

            <!-- Список юнитов (только в ручном режиме) -->
            <StackPanel x:Name="ManualPanel" Visibility="Collapsed">

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Heavy -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource UnitRowStyle}"
                            MouseLeftButtonDown="Heavy_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⬡" FontSize="18" Foreground="#B4B2A9" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Heavy" FontFamily="Georgia" FontSize="13" Foreground="#D3D1C7" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="50 монет  " FontSize="12" Foreground="#888780" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="18" Foreground="#FAC775" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Light -->
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource UnitRowStyle}"
                            MouseLeftButtonDown="Light_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✕" FontSize="18" Foreground="#B4B2A9" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Light" FontFamily="Georgia" FontSize="13" Foreground="#D3D1C7" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="30 монет  " FontSize="12" Foreground="#888780" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="18" Foreground="#FAC775" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Archer -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource UnitRowStyle}"
                            MouseLeftButtonDown="Archer_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="↑" FontSize="18" Foreground="#B4B2A9" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Archer" FontFamily="Georgia" FontSize="13" Foreground="#D3D1C7" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="40 монет  " FontSize="12" Foreground="#888780" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="18" Foreground="#FAC775" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Healer -->
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource UnitRowStyle}"
                            MouseLeftButtonDown="Healer_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✚" FontSize="18" Foreground="#B4B2A9" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Healer" FontFamily="Georgia" FontSize="13" Foreground="#D3D1C7" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="50 монет  " FontSize="12" Foreground="#888780" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="18" Foreground="#FAC775" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Wizard -->
                    <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource UnitRowStyle}"
                            MouseLeftButtonDown="Wizard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✶" FontSize="18" Foreground="#B4B2A9" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Wizard" FontFamily="Georgia" FontSize="13" Foreground="#D3D1C7" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="60 монет  " FontSize="12" Foreground="#888780" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="18" Foreground="#FAC775" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- GulyayGorod -->
                    <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource UnitRowStyle}"
                            MouseLeftButtonDown="GulyayGorod_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▦" FontSize="18" Foreground="#B4B2A9" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Гуляй-город" FontFamily="Georgia" FontSize="13" Foreground="#D3D1C7" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="70 монет  " FontSize="12" Foreground="#888780" VerticalAlignment="Center"/>
                                <TextBlock Text="+" FontSize="18" Foreground="#FAC775" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Состав армии -->
                <Border BorderBrush="#444441" BorderThickness="1" Padding="12" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="СОСТАВ АРМИИ"
                                   FontSize="11" Foreground="#5F5E5A" Margin="0,0,0,6"/>
                        <TextBlock x:Name="ArmyCompositionText"
                                   Text="— пусто —"
                                   FontFamily="Georgia" FontSize="13"
                                   Foreground="#B4B2A9"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Ошибка -->
                <TextBlock x:Name="ErrorText"
                           Text=""
                           Foreground="#E24B4A"
                           FontSize="12"
                           Margin="0,6,0,0"
                           Visibility="Collapsed"/>

            </StackPanel>

            <!-- Кнопки -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Назад"
                        Foreground="#888780"
                        BorderBrush="#444441"
                        Style="{StaticResource NavButtonStyle}"
                        x:Name="BackButton"/>

                <Button Grid.Column="2"
                        Content="Далее →"
                        Foreground="#FAC775"
                        BorderBrush="#888780"
                        Style="{StaticResource NavButtonStyle}"
                        x:Name="NextButton"/>
            </Grid>

        </StackPanel>
    </Grid>
</UserControl>