<Window x:Class="WpfPresentation.Views.ArmyCompositionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Состав армий"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="620" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Border Background="#2C2C2A"
            BorderBrush="#5F5E5A"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка (перетаскивание) -->
            <Border Grid.Row="0"
                    Background="#252523"
                    BorderBrush="#444441"
                    BorderThickness="0,0,0,1"
                    Padding="16,10"
                    MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚔" Foreground="#5F5E5A" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="СОСТАВ АРМИЙ"
                                   FontFamily="Georgia" FontSize="12"
                                   Foreground="#888780"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="⚔" Foreground="#5F5E5A" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseButton"
                            Content="✕"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            FontSize="12"
                            Foreground="#5F5E5A"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#33FF6B6B"/>
                                                    <Setter Property="Foreground" Value="#FF6B6B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Основной контент: две армии -->
            <Grid Grid.Row="1" Margin="16,12,16,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Армия 1 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="Army1NameText"
                                   FontFamily="Georgia" FontSize="15"
                                   Foreground="#FAC775"
                                   HorizontalAlignment="Center"/>
                        <Rectangle Height="1" Fill="#EF9F27" Width="60"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock x:Name="Army1StatsText"
                                   FontFamily="Georgia" FontSize="10"
                                   Foreground="#5F5E5A"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,6,0">
                        <StackPanel x:Name="Army1Panel"/>
                    </ScrollViewer>
                </Grid>

                <!-- Разделитель -->
                <Rectangle Grid.Column="1" Fill="#444441"/>

                <!-- Армия 2 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock x:Name="Army2NameText"
                                   FontFamily="Georgia" FontSize="15"
                                   Foreground="#FAC775"
                                   HorizontalAlignment="Center"/>
                        <Rectangle Height="1" Fill="#EF9F27" Width="60"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        <TextBlock x:Name="Army2StatsText"
                                   FontFamily="Georgia" FontSize="10"
                                   Foreground="#5F5E5A"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="6,0,0,0">
                        <StackPanel x:Name="Army2Panel"/>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Нижняя строка -->
            <Border Grid.Row="2"
                    BorderBrush="#444441"
                    BorderThickness="0,1,0,0"
                    Padding="16,8">
                <TextBlock x:Name="FooterText"
                           FontFamily="Georgia" FontSize="10"
                           Foreground="#444441"
                           HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
