<UserControl x:Class="WpfPresentation.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Цвета -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#2C2C2A"/>
        <SolidColorBrush x:Key="GoldBrush" Color="#FAC775"/>
        <SolidColorBrush x:Key="GoldDarkBrush" Color="#EF9F27"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#D3D1C7"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#888780"/>
        <SolidColorBrush x:Key="BorderActiveBrush" Color="#888780"/>
        <SolidColorBrush x:Key="BorderMutedBrush" Color="#5F5E5A"/>
        <SolidColorBrush x:Key="BorderDimBrush" Color="#444441"/>

        <!-- Стиль главной кнопки (Новая игра) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FAC775"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="Transparent"
                                BorderBrush="#888780"
                                BorderThickness="1"
                                Padding="24,0">
                            <Grid>
                                <TextBlock Text="⚔"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Foreground="#5F5E5A"
                                           FontSize="11"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Text="⚔"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Foreground="#5F5E5A"
                                           FontSize="11"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#FAC775"/>
                                <Setter TargetName="Border" Property="Background" Value="#33FAC775"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#55FAC775"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль обычной кнопки -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D3D1C7"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="Transparent"
                                BorderBrush="#5F5E5A"
                                BorderThickness="1"
                                Padding="24,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#888780"/>
                                <Setter TargetName="Border" Property="Background" Value="#22D3D1C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#44D3D1C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль кнопки Выход -->
        <Style x:Key="ExitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888780"/>
            <Setter Property="FontFamily" Value="Georgia"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="Transparent"
                                BorderBrush="#444441"
                                BorderThickness="1"
                                Padding="24,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5F5E5A"/>
                                <Setter Property="Foreground" Value="#D3D1C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Фон -->
    <Grid Background="#2C2C2A">
        <!-- Центрированная колонка -->
        <StackPanel Width="340"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <!-- Заголовок -->
            <TextBlock Text="Битва армий"
                       FontFamily="Georgia"
                       FontSize="36"
                       FontWeight="Normal"
                       Foreground="#FAC775"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>

            <!-- Золотая линия под заголовком -->
            <Rectangle Height="1"
                       Fill="#EF9F27"
                       Width="80"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,32"/>

            <!-- Кнопки -->
            <Button Content="Новая игра"
                    Style="{StaticResource PrimaryButtonStyle}"
                    x:Name="NewGameButton"
                    Margin="0,0,0,10"/>

            <Button Content="Загрузить игру"
                    Style="{StaticResource SecondaryButtonStyle}"
                    x:Name="LoadGameButton"
                    Margin="0,0,0,10"/>

            <Button Content="Помощь"
                    Style="{StaticResource SecondaryButtonStyle}"
                    x:Name="HelpButton"
                    Margin="0,0,0,10"/>

            <Button Content="Настройки наблюдателей"
                    Style="{StaticResource SecondaryButtonStyle}"
                    x:Name="ObserversButton"
                    Margin="0,0,0,0"/>

            <!-- Разделитель -->
            <Rectangle Height="1"
                       Fill="#444441"
                       Width="80"
                       HorizontalAlignment="Center"
                       Margin="0,16,0,16"/>

            <Button Content="Выход"
                    Style="{StaticResource ExitButtonStyle}"
                    x:Name="ExitButton"/>

            <!-- Декор внизу -->
            <TextBlock Text="✦ ✦ ✦"
                       Foreground="#444441"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>