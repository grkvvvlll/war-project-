<UserControl x:Class="WpfPresentation.Views.Units.WizardUnitControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="72">

    <UserControl.Resources>
        <Storyboard x:Key="SpellAnim">
            <ColorAnimation Storyboard.TargetName="Root"
                    Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                    To="#337F77DD" Duration="0:0:0.2"
                    AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="Root"
                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                     From="0" To="-4" Duration="0:0:0.2" AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="HitAnim">
            <ColorAnimation Storyboard.TargetName="Root"
                    Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                    To="#33E24B4A" Duration="0:0:0.1"
                    AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="DeathAnim">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.5"/>
        </Storyboard>
    </UserControl.Resources>

    <Canvas x:Name="Root" Width="48" Height="72" Background="Transparent">
        <Canvas.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Canvas.RenderTransform>
        <Canvas.Resources>
            <SolidColorBrush x:Name="StrokeColor" x:Key="StrokeBrush" Color="#B4B2A9"/>
        </Canvas.Resources>

        <!-- Остроконечная шляпа -->
        <Polygon Points="24,0 14,16 34,16"
                 Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5" Fill="Transparent"/>
        <Line X1="12" Y1="16" X2="36" Y2="16" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>

        <!-- Голова -->
        <Ellipse Canvas.Left="18" Canvas.Top="16" Width="12" Height="12"
                 Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5" Fill="Transparent"/>

        <!-- Мантия -->
        <Path Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5" Fill="Transparent"
              Data="M24,28 L14,56 L34,56 Z"/>

        <!-- Руки -->
        <Line X1="20" Y1="34" X2="8" Y2="42" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>
        <Line X1="28" Y1="34" X2="40" Y2="40" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>

        <!-- Посох -->
        <Line X1="8" Y1="42" X2="4" Y2="62" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>

        <!-- Звезда на посохе -->
        <Ellipse Canvas.Left="1" Canvas.Top="37" Width="6" Height="6"
                 Stroke="{StaticResource StrokeBrush}" StrokeThickness="1" Fill="Transparent"/>
        <Line X1="4" Y1="37" X2="4" Y2="43" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1"/>
        <Line X1="1" Y1="40" X2="7" Y2="40" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1"/>
    </Canvas>
</UserControl>