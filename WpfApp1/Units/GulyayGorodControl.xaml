<UserControl x:Class="WpfPresentation.Views.Units.GulyayGorodControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="72">

    <UserControl.Resources>
        <Storyboard x:Key="HitAnim">
            <ColorAnimation Storyboard.TargetName="Root"
                    Storyboard.TargetProperty="Background.(SolidColorBrush.Color)"
                    To="#33E24B4A" Duration="0:0:0.1"
                    AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="DeathAnim">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.5"/>
        </Storyboard>
    </UserControl.Resources>

    <Canvas x:Name="Root" Width="48" Height="72" Background="Transparent">
        <Canvas.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Canvas.RenderTransform>
        <Canvas.Resources>
            <SolidColorBrush x:Name="StrokeColor" x:Key="StrokeBrush" Color="#B4B2A9"/>
        </Canvas.Resources>

        <!-- Зубцы -->
        <Rectangle Canvas.Left="6" Canvas.Top="6" Width="8" Height="10"
                   Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5" Fill="Transparent"/>
        <Rectangle Canvas.Left="20" Canvas.Top="6" Width="8" Height="10"
                   Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5" Fill="Transparent"/>
        <Rectangle Canvas.Left="34" Canvas.Top="6" Width="8" Height="10"
                   Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5" Fill="Transparent"/>

        <!-- Стена -->
        <Rectangle Canvas.Left="4" Canvas.Top="16" Width="40" Height="30"
                   Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5" Fill="Transparent"/>

        <!-- Бойницы -->
        <Rectangle Canvas.Left="10" Canvas.Top="22" Width="7" Height="8"
                   Stroke="{StaticResource StrokeBrush}" StrokeThickness="1" Fill="Transparent"/>
        <Rectangle Canvas.Left="31" Canvas.Top="22" Width="7" Height="8"
                   Stroke="{StaticResource StrokeBrush}" StrokeThickness="1" Fill="Transparent"/>

        <!-- Ворота -->
        <Path Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5" Fill="Transparent"
              Data="M18,46 L18,36 Q24,30 30,36 L30,46 Z"/>

        <!-- Ось колёс -->
        <Line X1="4" Y1="52" X2="44" Y2="52" Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>

        <!-- Колёса -->
        <Ellipse Canvas.Left="5" Canvas.Top="47" Width="10" Height="10"
                 Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5" Fill="Transparent"/>
        <Ellipse Canvas.Left="33" Canvas.Top="47" Width="10" Height="10"
                 Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5" Fill="Transparent"/>

        <!-- Спицы колёс -->
        <Line X1="10" Y1="47" X2="10" Y2="57" Stroke="{StaticResource StrokeBrush}" StrokeThickness="0.8"/>
        <Line X1="5" Y1="52" X2="15" Y2="52" Stroke="{StaticResource StrokeBrush}" StrokeThickness="0.8"/>
        <Line X1="38" Y1="47" X2="38" Y2="57" Stroke="{StaticResource StrokeBrush}" StrokeThickness="0.8"/>
        <Line X1="33" Y1="52" X2="43" Y2="52" Stroke="{StaticResource StrokeBrush}" StrokeThickness="0.8"/>
    </Canvas>
</UserControl>