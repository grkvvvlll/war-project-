<UserControl x:Class="WpfPresentation.Views.Units.LightUnitControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="72">

    <UserControl.Resources>
        <Storyboard x:Key="AttackAnim">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="10" Duration="0:0:0.15"
                             AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="HitAnim">
            <ColorAnimation Storyboard.TargetName="Root"
                            Storyboard.TargetProperty="(Canvas.Background).(SolidColorBrush.Color)"
                            To="#33E24B4A"
                            Duration="0:0:0.1"
                            AutoReverse="True"/>
        </Storyboard>
        <Storyboard x:Key="DeathAnim">
            <DoubleAnimation Storyboard.TargetName="Root"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.5"/>
        </Storyboard>
    </UserControl.Resources>

    <Canvas x:Name="Root" Width="48" Height="72" 
            RenderTransformOrigin="0.5,0.5"
            Background="Transparent">
        <Canvas.RenderTransform>
            <TranslateTransform X="0" Y="0"/>
        </Canvas.RenderTransform>

        <Canvas.Resources>
            <SolidColorBrush x:Name="StrokeColor" x:Key="StrokeBrush" Color="#B4B2A9"/>
        </Canvas.Resources>

        <!-- Голова -->
        <Ellipse Canvas.Left="17" Canvas.Top="3"
                 Width="14" Height="14"
                 Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"
                 Fill="Transparent"/>

        <!-- Тело -->
        <Line X1="24" Y1="17" X2="24" Y2="42"
              Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>

        <!-- Левая рука -->
        <Line X1="24" Y1="24" X2="10" Y2="34"
              Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>

        <!-- Правая рука -->
        <Line X1="24" Y1="24" X2="38" Y2="34"
              Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>

        <!-- Меч -->
        <Line X1="38" Y1="34" X2="44" Y2="22"
              Stroke="{StaticResource StrokeBrush}" StrokeThickness="2"/>
        <!-- Гарда -->
        <Line X1="40" Y1="30" X2="46" Y2="30"
              Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>

        <!-- Левая нога -->
        <Line X1="24" Y1="42" X2="16" Y2="58"
              Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>

        <!-- Правая нога -->
        <Line X1="24" Y1="42" X2="32" Y2="58"
              Stroke="{StaticResource StrokeBrush}" StrokeThickness="1.5"/>
    </Canvas>
</UserControl>